{
  "name": "@sa-marketplace/entities",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "npx rimraf dist && tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "seed": "ts-node src/seeds/seed.ts",
    "db:check": "ts-node src/database/boot-check.ts"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "typeorm-naming-strategies": "^4.1.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.4.16",
    "@nestjs/config": "^3.3.0",
    "@nestjs/typeorm": "^10.0.2",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.0-rc.20"
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.16",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.16",
    "@nestjs/typeorm": "^10.0.2",
    "@sa-marketplace/eslint-config": "workspace:*",
    "@sa-marketplace/tsconfig": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.5.4",
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.0-rc.20"
  }
}
