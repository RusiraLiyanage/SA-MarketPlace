  "devDependencies": {
    "@nestjs/common": "^10.4.16",
    "@nestjs/swagger": "^7.0.1",
    "@sa-marketplace/eslint-config": "workspace:*",
    "@sa-marketplace/tsconfig": "workspace:*",
    "@types/express": "^4.17.13",
    "@types/jest": "^29.5.14",
    "@types/nodemailer": "^8.0.2",
    "express": "^5.0.1",
