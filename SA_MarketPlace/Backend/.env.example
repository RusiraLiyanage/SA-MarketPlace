# Copy to .env and adjust. .env is git-ignored — never commit real values.
# This is a copy of the .env file used in the local development environment.

NODE_ENV=development

# No PORT: each app owns its port (ADR 0016) — customer 8001, supplier 8002, admin 8003.

# Database connection.
# DB_PORT is the HOST port published by docker-compose. 5433, not 5432, because a
# local Postgres is likely already using 5432 (DATABASE.md §2).
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=sa_user
DB_PASSWORD=sa_local_password
DB_NAME=sa_marketplace

# Echo SQL to the console. Handy while building queries, noisy once they work.
DB_LOGGING=true

# Signs access tokens. Local only, never commit.
JWT_SECRET=89ce6d40b752530b32014ade9e14cafe6559a95aba43273c8e0f31780065d633
JWT_EXPIRES_IN=15m

AUTH_THROTTLE_LIMIT=5
AUTH_THROTTLE_TTL=60

CUSTOMER_RESET_URL=http://localhost:5173/reset-password
SUPPLIER_RESET_URL=http://localhost:5174/reset-password
ADMIN_RESET_URL=http://localhost:5175/reset-password
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
SUPPORT_EMAIL=partners@sampleassist.com.au
SUPPORT_PHONE=1800 123 456

# Optional (defaults shown). Admin sign-up is limited to these email domains (ADR 0038).
# ADMIN_EMAIL_DOMAINS=sampleassist.com.au
# Cap on rows in the admin orders CSV export (ADR 0042).
# ORDER_EXPORT_MAX_ROWS=

# Real email (backend ADR 0046). Leave all blank to only log emails (reset links then print in the API terminal).
# Set all four to send through a Gmail account: the OAuth client from Google Cloud, a refresh token for that account,
# and the account's address. See the README, "Real email".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Sample Assist Marketplace
# MAIL_FROM_NAME=Sample Assist Marketplace
